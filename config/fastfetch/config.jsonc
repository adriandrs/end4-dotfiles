{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "padding": { "top": 1, "right": 3, "left": 2 }
  },
  "display": {
    "separator": "  ",
    "key": { "width": 10 }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    "break",
    { "type": "os", "key": "󰣇 os" },
    { "type": "kernel", "key": "󰌽 ker", "format": "{release}" },
    { "type": "packages", "key": "󰏖 pkgs", "format": "{pacman} (pacman)" },
    { "type": "shell", "key": "󰆍 sh", "format": "{pretty-name}" },
    { "type": "wm", "key": "󰖯 wm", "format": "{pretty-name}" },
    { "type": "terminal", "key": "󰁨 term", "format": "{pretty-name}" },
    "break",
    { "type": "cpu", "key": "󰻠 cpu", "format": "{name}" },
    { "type": "gpu", "key": "󰢮 gpu", "format": "{name}" },
    { "type": "memory", "key": "󰍛 ram" },
    { "type": "disk", "key": "󰋊 disk", "folders": "/" },
    { "type": "battery", "key": "󰁹 bat", "format": "{capacity}" },
    { "type": "uptime", "key": "󰅐 up" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 },
    "break"
  ]
}
